{
  "expo": {
    "name": "Floosy",
    "slug": "Floosy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.m67x9.floosy"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C3B31",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.m67x9.floosy"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-router",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Floosy uses your photos so you can attach an invoice to an expense.",
          "cameraPermission": "Floosy uses the camera so you can photograph an invoice for an expense.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "floosy"
  }
}
